# Open Live Gateway settings.
#
# Normally written by `open-live-gateway setup`, which asks for each value and checks
# it. Written mode 0600: it holds the Open Live credential and any SRT passphrase.
# The file lives per user (~/.config/open-live-gateway/gateway.toml on Linux,
# ~/Library/Application Support/open-live-gateway/gateway.toml on macOS), or wherever
# --config points. Environment variables override the file: OLG_OPEN_LIVE_URL,
# OLG_OPEN_LIVE_API_KEY, OLG_OPEN_LIVE_AUTH_MODE, OLG_STROM_URL, OLG_STROM_API_KEY.
# Unknown keys are an error, so a typo cannot silently fall back to a default.

[gateway]
# Prefix of every source name in Open Live, so two venues' cameras can be told apart.
# Setup defaults it to the hostname. An optional `id` seeds the flow ids and also
# defaults to the hostname.
name = "Venue A"

# The Strom on this machine, which does the capturing and encoding. Not the cloud
# Strom, and not something Open Live knows about.
[strom]
url = "http://127.0.0.1:8080"
# Start a headless Strom when nothing is listening at url, and stop it again on the
# way out. A Strom already running is always adopted, never replaced or stopped.
manage = true
# The Strom executable: a name on PATH, or a path. A managed Strom keeps its flows
# in `data_dir`, which defaults to a directory beside this file.
binary = "strom"
# Set when an adopted Strom runs with STROM_API_KEY.
# api_key = "change-me"

[open_live]
url = "https://my-instance.eyevinn-open-live.auto.prod-se.osaas.io"
# osc:    api_key is an OSC personal access token, exchanged for a short-lived
#         service token. Needed for an OSC-hosted instance, whose proxy rejects a
#         PAT presented directly. Setup infers this from an osaas.io address.
# direct: api_key is sent as the bearer token as-is, for a self-hosted Open Live
#         with a static API_KEY, or none at all.
auth_mode = "osc"
api_key = "change-me"
# Register one source per input. Off for a box that only streams to a Strom.
register = true

# builtin.mpegtssrt_output. One port per input is allocated from port_range, lowest
# first in device-name order, so the same devices land on the same ports each run.
[uplink]
# caller:   this machine dials the cloud. Nothing inbound here; the cloud publishes
#           the ports.
# listener: the cloud dials this machine. Needs public_host and inbound UDP here.
mode = "caller"
port_range = "47110-47129"
# Rule of thumb: 3-4x the measured RTT.
latency_ms = 200
# The cloud Strom to send to. Leave unset to ask Open Live (GET /api/v1/server-info).
# host = "strom.example.com"
# public_host = "venue.example.com"
# 10 to 79 characters; letters, digits, and - _ . ~ ! *
# passphrase = "change-me-please"
# pbkeylen = 16

# builtin.videoenc. Strom picks the encoder element itself, hardware first, so this
# expresses intent rather than an element name.
[video]
codec = "h264"                  # h264 | h265 | av1 | vp9
bitrate_kbps = 6000
encoder_preference = "auto"     # auto | hardware | software
quality_preset = "ultrafast"    # ultrafast | fast | medium | slow | veryslow
tune = "zerolatency"
rate_control = "cbr"            # cbr | vbr | cqp
keyframe_interval = 25          # frames; one or two seconds' worth

# Capture format to request from each device. Blank takes whatever the device
# offers, which suits most devices: builtin.local_input cannot scale or re-time, so
# asking for a format a device does not advertise fails negotiation. Matching the
# production's format exactly (e.g. 1280x720 at 25/1) avoids uneven frame drops
# when the camera would otherwise pick its own rate.
[capture]
# video_resolution = "1280x720"
# video_framerate = "25/1"

[log]
level = "info"
